flowchart LR
    Auth["auth-service<br/>publica eventos"]

    subgraph rmq["RabbitMQ — stack aparte"]
        direction TB
        QEmail[["send_email<br/>quorum + DLQ"]]
        QWork[["create_perfil<br/>update_username<br/>quorum + DLQ"]]
        Fanout{{"account_events<br/>exchange fanout<br/>AccountSuspended · Reactivated"}}
    end

    PW["profile-worker<br/>crea y sincroniza el perfil"]
    EW["email-worker<br/>renderiza y envía"]
    TC["text-channel<br/>cierra las WebSockets"]
    Resend["Resend<br/>mail transaccional"]

    Auth -->|"PasswordReset<br/>Requested"| QEmail
    Auth -->|"UserCreated<br/>UsernameSet"| QWork
    Auth -->|"eventos de cuenta"| Fanout
    QEmail --> EW
    QWork --> PW
    Fanout -->|"cola durable"| PW
    Fanout -->|"cola exclusiva por réplica"| TC
    EW -->|"HTTPS"| Resend

    class Auth svc
    class QEmail,QWork,Fanout dato
    class PW,EW,TC svc
    class Resend externo
    classDef borde fill:#1f6feb,stroke:#0b3d91,color:#ffffff,stroke-width:2px
    classDef svc fill:#dbeafe,stroke:#1f6feb,color:#0b2a5b
    classDef dato fill:#ede9fe,stroke:#6d28d9,color:#2e1065
    classDef externo fill:#ffedd5,stroke:#c2410c,color:#7c2d12
    classDef apagado fill:#f1f5f9,stroke:#94a3b8,color:#475569